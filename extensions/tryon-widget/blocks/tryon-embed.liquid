{%- comment -%}
  FitSnap Try-On — App Embed Block
  Target: body — enable once in Theme Settings → App Embeds.
  Auto-injects the try-on button on product pages and collection icons on collection pages.
  No manual block placement needed per template.
{%- endcomment -%}

{%- assign app_enabled = shop.metafields.fitfyce.app_enabled | default: 'true' -%}
{%- if block.settings.enabled and app_enabled == 'true' -%}
  <div id="tryfit-embed-root"
    data-proxy-url="{{ shop.secure_url }}/apps/tryfit"
    data-shop="{{ shop.permanent_domain }}"
    data-widget-id="fitfyce-{{ shop.permanent_domain | replace: '.', '-' }}"
    data-widget-styles='{"button_color":"{{ shop.metafields.fitfyce.button_color | default: "#111827" | escape }}","button_text_color":"{{ shop.metafields.fitfyce.button_text_color | default: "#FFFFFF" | escape }}","hover_bg_color":"{{ shop.metafields.fitfyce.hover_bg_color | default: "#F3F4F6" | escape }}","button_border_radius":"{{ shop.metafields.fitfyce.button_border_radius | default: 8 | escape }}","button_width":"{{ shop.metafields.fitfyce.button_width | default: 0 | escape }}","button_height":"{{ shop.metafields.fitfyce.button_height | default: 0 | escape }}","button_padding_top":"{{ shop.metafields.fitfyce.button_padding_top | default: 10 | escape }}","button_padding_right":"{{ shop.metafields.fitfyce.button_padding_right | default: 24 | escape }}","button_padding_bottom":"{{ shop.metafields.fitfyce.button_padding_bottom | default: 10 | escape }}","button_padding_left":"{{ shop.metafields.fitfyce.button_padding_left | default: 24 | escape }}","button_margin_top":"{{ shop.metafields.fitfyce.button_margin_top | default: 0 | escape }}","button_margin_right":"{{ shop.metafields.fitfyce.button_margin_right | default: 0 | escape }}","button_margin_bottom":"{{ shop.metafields.fitfyce.button_margin_bottom | default: 0 | escape }}","button_margin_left":"{{ shop.metafields.fitfyce.button_margin_left | default: 0 | escape }}","button_text":"{{ shop.metafields.fitfyce.button_text | default: "Try On This Look" | escape }}","button_icon":"{{ shop.metafields.fitfyce.button_icon | default: "eye" | escape }}","icon_color":"{{ shop.metafields.fitfyce.icon_color | default: "#FFFFFF" | escape }}","icon_size":"{{ shop.metafields.fitfyce.icon_size | default: 16 | escape }}"}'
    {%- if request.page_type == 'product' -%}
    data-page-type="product"
    data-product-id="{{ product.id }}"
    data-product-tryon="{{ product.metafields.tryfit.tryon_enabled }}"
    data-variants="{{ product.variants | json | escape }}"
    data-options="{{ product.options | json | escape }}"
    data-clothing-images="{{ product.metafields.tryfit.variant_mappings }}"
    data-featured-image="{{ product.featured_image | image_url: width: 1024 }}"
    {%- elsif request.page_type == 'collection' -%}
    data-page-type="collection"
    data-collection-tryon="{{ collection.metafields.tryfit.tryon_enabled }}"
    {%- else -%}
    data-page-type="other"
    {%- endif -%}
    style="display:none"
  ></div>

  {%- render 'tryon-modal' -%}
  {{ 'tryon-widget.js' | asset_url | script_tag }}
  {{ 'tryon-modal.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{% schema %}
{
  "name": "FitSnap Try-On",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable FitSnap Button",
      "default": true
    }
  ]
}
{% endschema %}
