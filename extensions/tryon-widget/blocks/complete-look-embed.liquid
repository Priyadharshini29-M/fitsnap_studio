{%- comment -%}
  Brix-TryOn Complete Your Look — App Embed Block
  Target: body — enable once in Theme Settings → App Embeds.
  Separate module from the Try On widget: independently toggleable here in
  the theme editor, and gated by its own admin on/off switch (Complete Your
  Look page) plus per-product manual pairings — shows nothing unless both
  are set.
{%- endcomment -%}

{%- if request.page_type == 'product' -%}
  <div id="fitfyce-complete-look-root"
    data-proxy-url="https://{{ shop.permanent_domain }}/apps/tryfit"
    data-shop="{{ shop.permanent_domain }}"
    data-product-id="{{ product.id }}"
    data-currency="{{ shop.currency }}"
    style="display:none"
  ></div>

  {{ 'complete-look-widget.css' | asset_url | stylesheet_tag }}
  {{ 'complete-look-widget.js' | asset_url | script_tag }}
{%- endif -%}

{% schema %}
{
  "name": "Brix-TryOn Complete Look",
  "target": "body",
  "settings": []
}
{% endschema %}
